<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear libro</title>
    <script src="/js/books.js" defer></script>
    <!--link rel="stylesheet" href="/nou_css.css"-->
</head>
<body>
    <header>
        <h1>Crear libro</h1>
    </header>
    
    <main>
        <form id="new-book-form" action="/books/new" method="POST">
            <label for="name">Título:</label>
            <input type="text" id="new-book-name" name="name" value="<%= book.name %>" required>
            
            <label for="author">Autor:</label>
            <input type="text" id="new-book-author" name="author" value="<%= book.author %>" required>

            <label for="year">Año:</label>
            <input type="number" id="new-book-year" name="year" value="<%= book.year %>" required>

            <button type="submit">Confirmar i crear</button>
            <span></span>
        </form>
        <a href="/books">Volver al listado</a>
    </main>
</body>
</html>