<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar libro</title>
    <script src="/js/booksEdit.js" defer></script>
    <!--link rel="stylesheet" href="/nou_css.css"-->
</head>
<body>
    <header>
        <h1>Editar libro: <%= book.name %></h1>
    </header>
    
    <main>
        <form id="edit-book-form" action="/books/<%= book.id %>" method="POST">
            <input type="hidden" name="_method" value="PUT">
            <label for="name">Título:</label>
            <input type="text" id="name" name="name" value="<%= book.name %>" required>
            
            <label for="author">Autor:</label>
            <input type="text" id="author" name="author" value="<%= book.author %>" required>

            <label for="year">Año:</label>
            <input type="number" id="year" name="year" value="<%= book.year %>" required>

            <button type="submit">Desar Canvis</button>
            <p id="edit-book-message"></p>
        </form>
        <a href="/books">Volver al listado</a>
    </main>
</body>
</html>