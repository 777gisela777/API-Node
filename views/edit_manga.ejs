<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar manga</title>
    <script src="/js/mangasEdit.js" defer></script>
    <!--link rel="stylesheet" href="/nou_css.css"-->
</head>
<body>
    <header>
        <h1>Editar manga: <%= manga.name %></h1>
    </header>
    
    <main>
        <form id="edit-manga-form" action="/mangas/<%= manga.id %>" method="POST">
            <input type="hidden" name="_method" value="PUT">
            <label for="name">Títol:</label>
            <input type="text" id="name" name="name" value="<%= manga.name %>" required>
            
            <label for="author">Autor:</label>
            <input type="text" id="author" name="author" value="<%= manga.author %>" required>

            <label for="year">Any:</label>
            <input type="number" id="year" name="year" value="<%= manga.year %>" required>

            <button type="submit">Desar Canvis</button>
            <p id="edit-manga-message"></p>
        </form>
        <a href="/mangas">Tornar al llistat</a>
    </main>
</body>
</html>