<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear manga</title>
    <script src="/js/mangas.js" defer></script>
    <!--link rel="stylesheet" href="/nou_css.css"-->
</head>
<body>
    <header>
        <h1>Crear manga</h1>
    </header>
    
    <main>
        <form id="new-manga-form" action="/mangas/new" method="POST">
            <label for="name">Títol:</label>
            <input type="text" id="new-manga-name" name="name" value="<%= manga.name %>" required>
            
            <label for="author">Autor:</label>
            <input type="text" id="new-manga-author" name="author" value="<%= manga.author %>" required>

            <label for="year">Any:</label>
            <input type="number" id="new-manga-year" name="year" value="<%= manga.year %>" required>

            <button type="submit">Confirmar i crear</button>
            <span></span>
        </form>
        <a href="/mangas">Tornar al llistat</a>
    </main>
</body>
</html>