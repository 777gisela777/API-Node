<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mangas</title>
    <!--link rel="stylesheet" href="styles.css" /-->
    <script src="/js/mangasDelete.js" defer></script>
  </head>
  <body>
    <div class="container">
        <% if (typeof user !== 'undefined') { %>
            <div class="form-container">
                <h2>Mangas</h2>
                <button><a href="/mangas/new">Afegir un manga</a></button>
                <% data.mangas.forEach(manga => { %>
                  <div manga="<%= manga.id %>">
                    <p><strong><%= manga.name %></strong> - <%= manga.author %> (<%= manga.year %>)</p>
                    <a href="/mangas/<%= manga.id %>/edit">Editar</a>
                    <button type="button" esborrar="<%= manga.id %>">Eliminar</button>
                  </div>
                <% }) %>
                <a href="/protected">Tornar a la pàgina d'admin</a>
            </div>
        <% } %>
    </div>
    
  </body>
</html>
